# Repository upload allowlist
#
# Only the runtime project, selected rule file, runtime knowledge/cache/output
# directories, and the two requested README files are published. Everything
# else at the repository root is kept local unless explicitly allowed below.
/*

!/.gitignore
!/README.md
!/readme-2.md

!/src/
!/src/**

!/data/
/data/*
!/data/all_rules_2026_with_fields.json

!/cache/
!/cache/**
!/database/
!/database/**
!/knowledge/
!/knowledge/**
!/logs/
!/logs/**
!/results/
!/results/**

# Local secrets and environment-specific configuration
.env
.env.*
*.env

# Python/editor caches that may appear inside an allowed directory
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.venv/
venv/
env/
.idea/
.vscode/
.codex-backup/
.DS_Store

# Temporary Office lock files
~$*
